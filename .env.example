# Copy to a protected environment. Never commit a populated .env file.
# DeepSWE uses deepseek-v4-flash-0731 for both Codex CLI and mini-swe-agent.
MEMTRACE_CODEX_MODEL=deepseek-v4-flash-0731
MEMTRACE_MINISWE_MODEL=deepseek-v4-flash-0731
MEMTRACE_MINISWE_REASONING_EFFORT=high
MEMTENSOR_DOMESTIC_API_KEY=
HOMY_ENABLE_CODE_GRAPH_SEARCH=1
# Non-Python repositories only. Set this to the checkout HEAD before launch.
HOMY_MULTILANG_BASE_COMMIT=
# mini-swe-agent in a container. Leave unset for Codex CLI.
LITELLM_LOCAL_MODEL_COST_MAP=True
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
MSWEA_COST_TRACKING=ignore_errors
